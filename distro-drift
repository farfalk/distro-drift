# ═══════════════════════════════════════════════════════════════════════
# --verify: check a stored snapshot against the live system.
#
# Parses the snapshot for custom modifications and checks each one against
# current state: custom systemd units (enabled? active?), ExecStart targets
# (binary still exists?), custom config files and scripts (still present?),
# third-party repos (still listed?).
#
# Exit status: 0 = all OK, 1 = some MISSING or BROKEN, 2 = error.
verify_snapshot() {
    local snap="$1"
    local v_ok=0 v_broken=0 v_missing=0
    local unit path state active binary line sub label
    local seen="$TMP/verify_seen"
    : > "$seen"

    # An interrupted --save leaves a header-only snapshot with no "Done"
    # footer. Verifying it would report 0 OK / 0 MISSING and exit 0 —
    # a false pass on the tool's own known failure mode. Refuse instead.
    if ! grep -q '^Done — ' "$snap"; then
        die 2 "snapshot appears incomplete (no Done footer)" \
            "likely an interrupted --save; take a new one: sudo distro-drift --save"
    fi

    echo "distro-drift verify $VERSION — $(date -Is)"
    echo "snapshot: $(basename "$snap" .txt)"
    echo "system:   $(hostname)   kernel: $(uname -r)"
    echo

    # Check a path: print status, count, and record it to avoid duplicates.
    vs_check() {
        local status="$1" item="$2"
        printf '  %-8s %s\n' "$status" "$item"
        case "$status" in
            OK)       v_ok=$((v_ok + 1)) ;;
            MISSING)  v_missing=$((v_missing + 1)) ;;
            BROKEN)   v_broken=$((v_broken + 1)) ;;
        esac
    }

    # Returns 0 if path was already checked, 1 if new (and records it).
    vs_dedup() {
        grep -qxF "$1" "$seen" && return 0
        printf '%s\n' "$1" >> "$seen"
        return 1
    }

    # Extract a subsection from the snapshot by its --- label ---
    vs_sub() {
        awk -v lbl="--- $1 ---" '
            index($0, lbl) == 1 { found=1; next }
            found && /^--- / { exit }
            found { print }
        ' "$snap"
    }

    # --- Custom systemd units ---
    echo "--- Custom systemd units ---"
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        case "$line" in *"  ->  "*) ;; *) continue ;; esac
        unit=${line#  }
        unit=${unit%%  ->*}
        path=${line##*  ->  }
        printf '%s\n' "$path" >> "$seen"

        if [ ! -f "$path" ]; then
            vs_check MISSING "$unit"
        else
            state=$(systemctl is-enabled "$unit" 2>/dev/null)
            active=$(systemctl is-active "$unit" 2>/dev/null)
            if [ "$state" = "not-found" ] || [ -z "$state" ]; then
                printf '  %-8s %s  (no longer loaded)\n' "MISSING" "$unit"
                v_missing=$((v_missing + 1))
            elif [ "$active" = "failed" ]; then
                printf '  %-8s %s  (%s, FAILED)\n' "BROKEN" "$unit" "$state"
                v_broken=$((v_broken + 1))
            elif [ "$state" = "enabled" ] && [ "$active" != "active" ]; then
                printf '  %-8s %s  (%s, %s)\n' "BROKEN" "$unit" "$state" "$active"
                v_broken=$((v_broken + 1))
            else
                printf '  %-8s %s  (%s, %s)\n' "OK" "$unit" "$state" "$active"
                v_ok=$((v_ok + 1))
            fi
        fi
    done < <(vs_sub "Enabled units not owned by any package")
    echo

    # --- Masked units ---
    echo "--- Masked units ---"
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        unit=$(echo "$line" | awk '{print $1}')
        [ -z "$unit" ] && continue

        state=$(systemctl is-enabled "$unit" 2>/dev/null)
        if [ "$state" = "masked" ]; then
            vs_check OK "$unit"
        elif [ "$state" = "not-found" ] || [ -z "$state" ]; then
            printf '  %-8s %s  (no longer loaded)\n' "MISSING" "$unit"
            v_missing=$((v_missing + 1))
        else
            printf '  %-8s %s  (unmasked, now %s)\n' "BROKEN" "$unit" "$state"
            v_broken=$((v_broken + 1))
        fi
    done < <(vs_sub "Masked units")
    echo

    # --- Systemd drop-in files ---
    echo "--- Systemd drop-in files ---"
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        vs_dedup "$path" && continue
        if [ -f "$path" ]; then
            vs_check OK "$path"
        else
            vs_check MISSING "$path"
        fi
    done < <(vs_sub "Overrides and drop-ins under /etc/systemd" | sed -n 's/^\[\(.*\)\]$/\1/p')
    echo

    # --- ExecStart dependencies ---
    echo "--- ExecStart dependencies ---"
    while IFS=$'\t' read -r path exec_cmd; do
        [ -z "$path" ] && continue
        [ -z "$exec_cmd" ] && continue
        exec_cmd=${exec_cmd#-}
        binary=$(echo "$exec_cmd" | awk '{print $1}')
        [ -z "$binary" ] && continue

        unit=$(basename "$path")
        if [ -e "$binary" ]; then
            printf '  %-8s %s  (%s)\n' "OK" "$binary" "$unit"
            v_ok=$((v_ok + 1))
        else
            printf '  %-8s %s  (ExecStart of %s)\n' "MISSING" "$binary" "$unit"
            v_missing=$((v_missing + 1))
        fi
        printf '%s\n' "$binary" >> "$seen"
    done < <(awk '
        /^\[.*\]$/ {
            if (path != "" && exec != "") print path "\t" exec
            path = substr($0, 2, length($0)-2)
            exec = ""
            next
        }
        /ExecStart=/ {
            line = $0
            sub(/^ *ExecStart=/, "", line)
            if (exec == "") exec = line
        }
        END {
            if (path != "" && exec != "") print path "\t" exec
        }
    ' < <(vs_sub "Overrides and drop-ins under /etc/systemd"))
    echo

    # --- User systemd units ---
    echo "--- User systemd units ---"
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        path=${line#"${line%%[![:space:]]*}"}
        case "$path" in
            *:) continue ;;
            /*) ;;
            *) continue ;;
        esac
        vs_dedup "$path" && continue
        if [ -f "$path" ]; then
            vs_check OK "$path"
        else
            vs_check MISSING "$path"
        fi
    done < <(vs_sub "User units")
    echo

    # --- Custom config files ---
    echo "--- Custom config files ---"
    for sub in "Local modprobe.d entries" "Local udev rules" "Local sysctl settings"; do
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            path=$(echo "$line" | sed -n 's/^\[\(.*\)\]$/\1/p')
            [ -z "$path" ] && continue
            vs_dedup "$path" && continue
            if [ -f "$path" ]; then
                vs_check OK "$path"
            else
                vs_check MISSING "$path"
            fi
        done < <(vs_sub "$sub")
    done
    echo

    # --- Custom files (section 4) ---
    echo "--- Custom files ---"
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        path=$(echo "$line" | sed -n 's/^  *[0-9][0-9]*d  \(.*\)$/\1/p')
        [ -z "$path" ] && continue
        vs_dedup "$path" && continue
        if [ -f "$path" ]; then
            vs_check OK "$path"
        else
            vs_check MISSING "$path"
        fi
    done < <(grep -E '^  +[0-9]+d  /' "$snap" 2>/dev/null)
    echo

    # --- Third-party repositories ---
    echo "--- Third-party repositories ---"
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        name=$(echo "$line" | sed -n 's/^\[\(.*\)\]  .*/\1/p')
        [ -z "$name" ] && continue
        if [ -f "/etc/apt/sources.list.d/$name" ]; then
            printf '  %-8s %s\n' "OK" "$name"
            v_ok=$((v_ok + 1))
        else
            printf '  %-8s %s\n' "MISSING" "$name"
            v_missing=$((v_missing + 1))
        fi
    done < <(vs_sub "Additional repositories")
    echo

    printf 'Summary: %d OK, %d MISSING, %d BROKEN\n' "$v_ok" "$v_missing" "$v_broken"

    [ "$v_missing" -gt 0 ] || [ "$v_broken" -gt 0 ] && return 1
    return 0
}

# ═══════════════════════════════════════════════════════════════════════
case "$MODE" in
    report) run_report ;;
    save)
        mkdir -p "$SNAPDIR" || die 1 "cannot create $SNAPDIR"
        out="$SNAPDIR/$(date +%F-%H%M).txt"
        if [ -e "$out" ]; then
            die 1 "$out already exists — refusing to overwrite a snapshot from the same minute" \
                "wait a minute and re-run, or remove it first"
        fi
        # Write to a temp file in $SNAPDIR, then rename — atomic on the same
        # filesystem. An interrupted --save leaves no partial snapshot behind
        # (the EXIT trap removes the temp); the chmod happens on the temp, so
        # the final file is never world-readable even briefly. Mode 0640 with
        # the invoking user's group lets that user (and tools running as them)
        # read snapshots without sudo. The content is paths and names, not
        # secrets; the invoking user is the admin who typed their sudo password.
        tmp_snap="$SNAPDIR/.tmp.$$.txt"
        trap 'rm -rf "$TMP" "$tmp_snap"' EXIT
        if run_report > "$tmp_snap"; then
            chmod 0640 "$tmp_snap"
            if [ -n "${SUDO_USER:-}" ]; then
                chgrp "$(id -gn "$SUDO_USER")" "$tmp_snap"
            fi
            mv "$tmp_snap" "$out" || die 1 "cannot install snapshot $out"
            echo "Snapshot written: $out"
            echo "Compare later with:  sudo distro-drift --diff     (latest snapshot vs now)"
            echo "                     distro-drift --diff @1 @0       (two stored snapshots — no root)"
            echo "List references:     distro-drift --snapshots"
            echo "Keep a copy OFF this machine."
        else
            die 1 "failed to write snapshot"
        fi
        ;;
    diff)
        # With one operand (or none) the right-hand side is the current state.
        if [ -z "$DIFF_B" ]; then DIFF_B="now"; fi

        a=$(resolve_ref "$DIFF_A" 2>"$TMP/e") || ref_die 2 "$TMP/e"
        b=$(resolve_ref "$DIFF_B" 2>"$TMP/e") || ref_die 2 "$TMP/e"

        if [ -z "$a" ]; then
            die 2 "no snapshot to compare against" "run: sudo distro-drift --save"
        fi

        # Unreadable snapshots would diff as two empty streams and falsely
        # report "identical" — fail with 2 (error) instead.
        for f in "$a" "$b"; do
            if [ "$f" != now ] && [ ! -r "$f" ]; then
                die 2 "cannot read snapshot: $f" \
                    "snapshots are mode 0640 (older ones 0600) — try: sudo distro-drift --diff"
            fi
        done

        materialise() {   # "now" -> generated report; otherwise the file itself
            if [ "$1" = now ]; then run_report > "$2"; printf '%s\n' "$2"
            else printf '%s\n' "$1"; fi
        }
        fa=$(materialise "$a" "$TMP/a.txt")
        fb=$(materialise "$b" "$TMP/b.txt")

        label() { if [ "$1" = now ]; then echo "current system state"; else basename "$1"; fi; }
        # JSON labels are machine-friendly: the file name, or "now".
        jlabel() { if [ "$1" = now ]; then echo now; else basename "$1"; fi; }

        # drop header lines that change on every run and would mask real drift
        strip() { grep -vE '^(distro-drift [0-9]|Done —|dpkg index|host: | *cruft report:)'; }
        diff <(strip < "$fa") <(strip < "$fb") > "$TMP/diff.out"
        rc=$?

        if [ "$JSON" = 1 ]; then
            if [ "$rc" -eq 0 ]; then ident=true; else ident=false; fi
            printf '{"schema":1,"tool":"distro-drift","version":"%s","generated":"%s","a":"%s","b":"%s","identical":%s,"diff":[' \
                "$VERSION" "$(date -Is)" \
                "$(jesc "$(jlabel "$a")")" "$(jesc "$(jlabel "$b")")" "$ident"
            n=0
            while IFS= read -r line || [ -n "$line" ]; do
                [ "$n" -gt 0 ] && printf ','
                printf '"%s"' "$(jesc "$line")"
                n=$((n + 1))
            done < "$TMP/diff.out"
            printf ']}\n'
            exit "$rc"
        fi

        echo "--- a: $(label "$a")"
        echo "+++ b: $(label "$b")"
        echo "  '<' only in a    '>' only in b"
        echo
        cat "$TMP/diff.out"
        [ "$rc" -eq 0 ] && echo "  (identical)"
        exit "$rc"
        ;;
    verify)
        snap=$(resolve_ref "$VERIFY_REF" 2>"$TMP/e") || ref_die 2 "$TMP/e"
        if [ -z "$snap" ] || [ "$snap" = "now" ]; then
            die 2 "--verify needs a stored snapshot, not 'now'" \
                "see: distro-drift --snapshots"
        fi
        if [ ! -r "$snap" ]; then
            die 2 "cannot read snapshot: $snap" \
                "snapshots are mode 0640 (older ones 0600) — try: sudo distro-drift --verify"
        fi
        verify_snapshot "$snap"
        exit $?
        ;;
esac
